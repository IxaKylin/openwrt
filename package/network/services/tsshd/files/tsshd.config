# tsshd configuration file
# tsshd is an SSH server that supports connection migration for roaming

config tsshd
	option enable '1'
	# Port range for UDP connection (default: 61001-61999)
	option Port '61001-61999'
	# Enable KCP mode for low latency
	option KcpMode '0'
	# Enable QUIC mode
	option QuicMode '0'
